# Copy to .env and adjust. Never commit .env (it may hold your API key).

# --- follower identity (from Nevil's bring-up; change only after a human check) ---
FOLLOWER_SERIAL=5B7B015207
FOLLOWER_ID=follower_nevil
# Pinned to the PREVIOUS follower calibration on purpose: the drawing controller is not re-commissioned for
# the 2026-10-07 recalibration (approved file 03b26c33...), so it refuses to start. Do not change without ENYOLAB.
FOLLOWER_CALIBRATION_SHA256=f48d50d5ba8c220f13575f13c1d6562d9431391fb1e726541abdaf2c4e714a9d
# Default calibration folder; uncomment only if you put the file elsewhere:
# FOLLOWER_CALIBRATION_DIR=~/.cache/huggingface/lerobot/calibration/robots/so_follower

# Joints the controller may move by default (comma separated). Proven joints only.
FOLLOWER_ENABLED_JOINTS=shoulder_pan
# Torque is switched OFF automatically after this many seconds without a move (max 600).
FOLLOWER_IDLE_TIMEOUT_S=120
FOLLOWER_SESSION_TIMEOUT_S=900

# --- cameras: AVFoundation unique IDs. They CHANGE with the USB port / Mac:
#     run `python camera.py --list` and copy the IDs here.
PRIMARY_CAMERA_ID=0x11100000c456366
SECONDARY_CAMERA_ID=0x11200000c456367

# --- Astra (OpenAI Responses API). Read ONLY by astra.py; never logged.
OPENAI_API_KEY=
ASTRA_MODEL=gpt-6-astra

# --- drawing orientation: set to 1 if the drawing comes out mirrored / upside down
DRAW_FLIP_U=0
DRAW_FLIP_V=0
